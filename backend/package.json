{
  "name": "kmiss-backend",
  "version": "1.0.0",
  "description": "API backend del sistema de gestión de clínica Vitalis",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
